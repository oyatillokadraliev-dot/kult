# ╔══════════════════════════════════════╗
# ║   КУЛЬТ — переменные окружения       ║
# ╚══════════════════════════════════════╝
# Скопируй этот файл как .env и заполни значения.
# Файл .env НИКОГДА не добавляется в Git (он в .gitignore).

# ─── Telegram ───────────────────────────
TELEGRAM_BOT_TOKEN=сюда_вставь_токен_от_BotFather
TELEGRAM_BOT_USERNAME=kult_astrakhan_bot

# ─── Firebase ───────────────────────────
# Скачай из Firebase Console → Project Settings → Service Accounts
# → Generate new private key → скачается JSON-файл
# Скопируй значения отсюда:
FIREBASE_PROJECT_ID=fiz-cult
FIREBASE_PRIVATE_KEY_ID=сюда_из_json
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nсюда_длинный_ключ\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=сюда_из_json
FIREBASE_CLIENT_ID=сюда_из_json

# ─── Сервер ─────────────────────────────
PORT=3000

# ─── URL сайта (для webhook бота) ───────
# Если деплоишь на Railway/Render — вставь их URL
# Пример: https://kult-bot.railway.app
SERVER_URL=https://твой-адрес.railway.app
